{
  "name": "leeeeeoy-portfolio-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test",
    "content:check": "node scripts/check-content.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.1",
    "vite": "^7.2.0",
    "wrangler": "4.152.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true,
    "fsevents": false
  },
  "overrides": {
    "undici@>=7.0.0 <7.30.1": "7.30.1"
  }
}
