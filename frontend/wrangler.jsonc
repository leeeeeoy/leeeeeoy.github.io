{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leeeeeoy-portfolio-frontend",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "routes": [
    {
      "pattern": "portfolio.leeeeeoy.xyz",
      "custom_domain": true
    }
  ],
  "env": {
    "preview": {
      "name": "leeeeeoy-portfolio-frontend-preview",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "preview-portfolio.leeeeeoy.xyz",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "observability": {
        "enabled": true,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01
        }
      }
    }
  }
}
